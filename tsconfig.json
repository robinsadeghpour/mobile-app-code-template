{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "jest.setup.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "config.d.ts",
    "uniwind-types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "*.config.js",
    "config.js",
    ".eslintrc.js",
    "supabase/functions/"
  ]
}
