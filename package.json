{
  "name": "mobile-app-code-template",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": "github:robinsadeghpour/mobile-app-code-template",
  "engines": {
    "node": ">=20"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "lint": "npx expo lint src supabase/functions",
    "typecheck": "npx expo customize tsconfig.json && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"supabase/functions/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
